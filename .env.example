# TrustShield AI Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-strong-random-key-in-production

# LLM API Keys (Optional — rule-based fallback used when absent)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Database
DATABASE_URL=sqlite:///./trustshield.db
